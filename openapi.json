{
  "openapi": "3.0.0",
  "info": {
    "title": "Elpima Surgicals Limited — Catalog & WhatsApp Quote API",
    "version": "1.0.0",
    "description": "High-performance REST API for B2B Surgical Equipment Catalog and WhatsApp Quotation Platform.",
    "contact": {
      "name": "Elpima Surgicals Technical Team",
      "email": "info@elpimasurgicals.com"
    }
  },
  "servers": [
    {
      "url": "http://localhost:5000",
      "description": "Local development server"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Enter your Bearer JWT token"
      }
    },
    "schemas": {
      "StandardSuccess": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "message": {
            "type": "string",
            "example": "Operation completed successfully"
          },
          "data": {
            "type": "object"
          }
        }
      },
      "StandardError": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": false
          },
          "error": {
            "type": "object",
            "properties": {
              "message": {
                "type": "string",
                "example": "Invalid request payload"
              },
              "kind": {
                "type": "string",
                "example": "validation_error"
              },
              "correlationId": {
                "type": "string",
                "example": "3fa85f64-5717-4562-b3fc-2c963f66afa6"
              },
              "details": {
                "type": "object"
              }
            }
          }
        }
      }
    }
  },
  "paths": {},
  "tags": []
}