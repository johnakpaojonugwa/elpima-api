# Server Configuration
NODE_ENV=development
PORT=5000
CORS_ORIGIN=*

# Database Connection (PostgreSQL or Supabase connection string)
DATABASE_URL=postgresql://postgres:postgres@localhost:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Redis Cache & Distributed Rate Limiting (Optional)
# REDIS_URL=redis://localhost:6379

# Security / JWT (Super-Admin & Supervising Manager)
JWT_SECRET=super_secure_elpima_jwt_secret_min_32_chars_long
JWT_EXPIRES_IN=3d

# Elpima Official Contact Details (Default for Quote Deep Links)
DEFAULT_WHATSAPP_NUMBER=2348118941799
COMPANY_NAME="Elpima Surgicals Limited"
COMPANY_EMAIL=info@elpimasurgicals.com
COMPANY_PHONE=+2348118941799
COMPANY_ADDRESS="Kaduna, Nigeria"

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SECRET_KEY=your-supabase-secret-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
SUPABASE_JWT_AUDIENCE=authenticated

# Supabase Storage S3 Configuration (Optional direct S3 endpoint)
SPB_STORAGE_ACCESS_KEY_ID=your-storage-access-key-id
SPB_STORAGE_SECRET_ACCESS_KEY=your-storage-secret-access-key
SUPABASE_STORAGE_ENDPOINT=https://your-project.storage.supabase.co/storage/v1/s3
SUPABASE_STORAGE_REGION=eu-central-1

# Sales Desk RFQ Notifications (Optional - webhook triggered when a new quote inquiry arrives)
# SALES_DESK_WEBHOOK_URL=https://webhook.site/your-sales-desk-endpoint
