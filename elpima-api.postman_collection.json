            }
          }
        }
      ]
    },
    {
      "name": "5. Quotes & WhatsApp RFQ Engine",
      "item": [
        {
          "name": "Submit Quote Inquiry (Public with WhatsApp Redirect)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "test-rfq-key-001" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerName\": \"Dr. Sarah Johnson\",\n  \"customerPhone\": \"08012345678\",\n  \"customerEmail\": \"dr.sarah@apexcare.ng\",\n  \"hospitalClinic\": \"Apex Care Specialist Hospital\",\n  \"location\": \"Abuja, Nigeria\",\n  \"priority\": \"URGENT\",\n  \"customerNotes\": \"Require fast delivery for scheduled general surgeries next week.\",\n  \"items\": [\n    {\n      \"productName\": \"Laparoscopic Trocar 10mm\",\n      \"quantity\": 2,\n      \"specNotes\": \"Autoclavable sleeve\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/quotes",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "quotes"]
            },
            "description": "Receives quote inquiry, registers reference RFQ-..., triggers webhook notification, and returns WhatsApp deep link."
          }
        },
        {
          "name": "Get Quote Metrics & Stats Overview (Staff)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/quotes/stats/overview",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "quotes", "stats", "overview"]
            }
          }
        },
        {
          "name": "List Quotes (Staff)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/quotes?page=1&limit=20&status=NEW",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "quotes"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" },
                { "key": "status", "value": "NEW" }
              ]
            }
          }
        },
        {
          "name": "Download Official Quote PDF",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/quotes/REPLACE_WITH_QUOTE_REFERENCE/pdf",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "quotes", "REPLACE_WITH_QUOTE_REFERENCE", "pdf"]
            },
            "description": "Streams official proforma quotation with Elpima letterhead, items table, and validity disclaimer."
          }
        },
        {
          "name": "Update Quote Status (Staff)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"QUOTED\",\n  \"adminNotes\": \"Proforma quotation sent via WhatsApp, awaiting PO.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/quotes/REPLACE_WITH_QUOTE_UUID/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "quotes", "REPLACE_WITH_QUOTE_UUID", "status"]
            }
          }
        }
      ]
    },
